# Public HTTPS origin on a VPS, localhost for local Compose.
PUBLIC_URL=http://localhost:4310
# Parallel runs and VM slots; any positive integer.
CONCURRENCY=4
LEO_IMAGE=ghcr.io/leo91000/leo-agent-manager:latest
# For development outside Docker only:
# DATA_DIR=.data
# AGENT_HOME=/home/you
# WORKSPACE_ROOTS=/home/you/projects
# Setup token is generated in DATA_DIR/setup-token; do not commit it.

# Official Claude Code CLI (subscription login is managed by the CLI).
CLAUDE_BIN=claude

# Optional conversation archives; credentials stay server-side (workload role or private AWS config).
ARCHIVE_S3_BUCKET=
# S3-compatible providers, e.g. OVHcloud Paris: https://s3.eu-west-par.io.cloud.ovh.net and DEEP_ARCHIVE
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_COLD_STORAGE_CLASS=
AWS_DEFAULT_REGION=

# Optional automatic agent portraits (OpenAI API billing, separate from subscriptions).
# Server-only key; never forwarded to agent runs. Without it, image uploads still work.
LEO_AVATAR_API_KEY=
