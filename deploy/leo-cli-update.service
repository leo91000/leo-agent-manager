[Unit]
Description=Check Leo Agent Manager Codex and GitHub CLI updates
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
Environment=LEO_MANAGER_CONTAINER=leo-manager
Environment=LEO_REPOSITORY=leo91000/leo-agent-manager
ExecStart=/usr/bin/docker exec ${LEO_MANAGER_CONTAINER} gh workflow run cli-updates.yaml --repo ${LEO_REPOSITORY} --ref main
TimeoutStartSec=120
Restart=on-failure
RestartSec=60
