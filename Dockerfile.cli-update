# syntax=docker/dockerfile:1
# The original deployed application image, never a moving tag or a chain of updates.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
ARG CODEX_VERSION
ARG GH_VERSION
ARG TARGETARCH
RUN test -n "$CODEX_VERSION" && test -n "$GH_VERSION" \
    && /usr/local/bin/pnpm add --global "@openai/codex@${CODEX_VERSION}"
RUN arch="${TARGETARCH:-amd64}" \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" -o /tmp/gh.tar.gz \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_checksums.txt" -o /tmp/gh-checksums.txt \
    && expected=$(awk -v name="gh_${GH_VERSION}_linux_${arch}.tar.gz" '$2 == name {print $1}' /tmp/gh-checksums.txt) \
    && test -n "$expected" && printf '%s  /tmp/gh.tar.gz\n' "$expected" | sha256sum --check - \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && cp "/tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh*
COPY cli-update-plan.json /tmp/cli-update-plan.json
RUN --mount=type=secret,id=github_token,env=GITHUB_TOKEN if [ -f /opt/leo-toolkit/manage.mjs ]; then \
      /usr/local/bin/node /opt/leo-toolkit/manage.mjs install /tmp/cli-update-plan.json \
      && apt-get update && apt-get upgrade -y --no-install-recommends \
      && rm -rf /var/lib/apt/lists/*; \
    fi \
    && rm /tmp/cli-update-plan.json
ARG BASE_IMAGE
ARG UPDATE_ID
ENV APP_BASE_IMAGE=$BASE_IMAGE APP_RUNTIME_ID=$UPDATE_ID APP_CODEX_VERSION=$CODEX_VERSION APP_GH_VERSION=$GH_VERSION
USER node
RUN codex --version && gh --version
